# Copy this file to `.env.prod` and fill in real values before deploying with
# `docker/docker-compose.prod.yml`. `.env.prod` itself is gitignored — never commit it.
#
# Every variable below is required by app/core/config.py's ProductionConfig.validate(),
# which the app runs once at startup and refuses to start if any check fails.

# Must be >= 32 characters and not one of the known-insecure defaults
# ProductionConfig.validate() checks against. Generate one with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Postgres password. Must not be the known-insecure default ("propnest_secret").
DB_PASSWORD=

# MinIO root password. Must not be the known-insecure default ("propnest_secret").
MINIO_ROOT_PASSWORD=

# Redis password. Required — docker/docker-compose.prod.yml passes this to Redis via
# `--requirepass`, and the app authenticates with it via REDIS_URL. Unlike the
# dev compose file, prod Redis has no unauthenticated fallback: this protects
# the login-lockout/rate-limit state AuthService keeps there.
REDIS_PASSWORD=

# Comma-separated list of allowed frontend origins for CORS, e.g.
# https://app.example.com,https://admin.example.com
# Optional — defaults to no allowed origins if unset.
CORS_ORIGINS=
